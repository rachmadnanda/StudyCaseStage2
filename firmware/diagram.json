{
  "version": 1,
  "author": "Tim Iki jenenge wes wkwk - Politeknik Negeri Malang",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },

    {
      "type": "wokwi-gas-sensor",
      "id": "mq2",
      "top": -150,
      "left": -230,
      "attrs": { "ppm": "5", "threshold": "4.0" }
    },

    {
      "type": "wokwi-dht22",
      "id": "dht1",
      "top": -150,
      "left": 130,
      "attrs": { "temperature": "29", "humidity": "61" }
    },

    { "type": "board-ssd1306", "id": "oled1", "top": -260, "left": 10, "attrs": {} },

    { "type": "wokwi-buzzer", "id": "bz1", "top": 70, "left": -170, "attrs": { "volume": "0.1" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "mq2:VCC", "esp:VIN", "red", [] ],
    [ "mq2:GND", "esp:GND.2", "black", [] ],
    [ "mq2:AOUT", "esp:D34", "green", [] ],
    [ "mq2:DOUT", "esp:D32", "blue", [] ],

    [ "dht1:VCC", "esp:3V3", "red", [] ],
    [ "dht1:SDA", "esp:D4", "green", [] ],
    [ "dht1:GND", "esp:GND.1", "black", [] ],

    [ "oled1:VCC", "esp:3V3", "red", [] ],
    [ "oled1:GND", "esp:GND.1", "black", [] ],
    [ "oled1:SDA", "esp:D21", "blue", [] ],
    [ "oled1:SCL", "esp:D22", "yellow", [] ],

    [ "bz1:1", "esp:GND.1", "black", [] ],
    [ "bz1:2", "esp:D25", "purple", [] ]
  ],
  "dependencies": {}
}
